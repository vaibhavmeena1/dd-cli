{
  "name": "deputydev",
  "version": "0.0.0",
  "description": "DeputyDev monorepo: the ddcli launcher plus the centralized management backend and frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/cli",
    "packages/*"
  ],
  "packageManager": "bun@1.4.1",
  "engines": {
    "bun": ">=1.4.1"
  },
  "scripts": {
    "cli": "bun run --cwd apps/cli dev",
    "check": "bun run --filter './apps/*' check && biome ci .",
    "typecheck": "bun run --filter './apps/*' typecheck",
    "test": "bun run --filter './apps/*' test",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12"
  }
}
