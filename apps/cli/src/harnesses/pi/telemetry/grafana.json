{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Metrics populated from OTLP",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "Traces populated from OTLP",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Interactions",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_interaction_count_total{user_id=~\"$user\",pi_repo_slug=~\"$repo\"}[$__range]))",
          "legendFormat": "Interactions"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Inferred retries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_agent_retry_inferred_total{user_id=~\"$user\",pi_repo_slug=~\"$repo\"}[$__range]))",
          "legendFormat": "Retries"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "LLM errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_llm_errors_total{user_id=~\"$user\"}[$__range])) or vector(0)",
          "legendFormat": "LLM errors"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Tool errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_tool_errors_total{user_id=~\"$user\"}[$__range])) or vector(0)",
          "legendFormat": "Tool errors"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Input tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_tokens_input_total{user_id=~\"$user\"}[$__range]))",
          "legendFormat": "Input tokens"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Output tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_tokens_output_total{user_id=~\"$user\"}[$__range]))",
          "legendFormat": "Output tokens"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Operational rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pi_interaction_count_total{user_id=~\"$user\",pi_repo_slug=~\"$repo\"}[5m])) by (user_id)",
          "legendFormat": "{{user_id}} interactions"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pi_turn_count_total{user_id=~\"$user\",pi_repo_slug=~\"$repo\"}[5m])) by (user_id)",
          "legendFormat": "{{user_id}} turns"
        },
        {
          "refId": "C",
          "expr": "sum(rate(pi_tool_calls_total{user_id=~\"$user\"}[5m])) by (user_id)",
          "legendFormat": "{{user_id}} tools"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "p95 duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(pi_interaction_duration_seconds_bucket{user_id=~\"$user\",pi_repo_slug=~\"$repo\"}[5m])) by (le))",
          "legendFormat": "Interaction"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(pi_llm_duration_seconds_bucket{user_id=~\"$user\"}[5m])) by (le))",
          "legendFormat": "LLM"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum(rate(pi_tool_duration_seconds_bucket{user_id=~\"$user\"}[5m])) by (le))",
          "legendFormat": "Tool"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "barchart",
      "title": "User interventions",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_user_intervention_count_total{user_id=~\"$user\",pi_repo_slug=~\"$repo\"}[$__range])) by (kind)",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "table",
      "title": "Recent interaction traces",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"pi.interaction\" && resource.\"user.id\" =~ \"$user\" && span.\"pi.repo.slug\" =~ \"$repo\" }",
          "limit": 50
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "timeseries",
      "title": "Context utilization p95 (by model)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(pi_context_utilization_percent_bucket{user_id=~\"$user\"}[5m])) by (le, gen_ai_request_model))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cost by model and usage source",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_cost_USD_total{user_id=~\"$user\"}[$__range])) by (gen_ai_response_model, pi_usage_source)",
          "legendFormat": "{{gen_ai_response_model}} ({{pi_usage_source}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Token mix",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pi_tokens_input_total{user_id=~\"$user\"}[5m]))",
          "legendFormat": "input"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pi_tokens_output_total{user_id=~\"$user\"}[5m]))",
          "legendFormat": "output"
        },
        {
          "refId": "C",
          "expr": "sum(rate(pi_tokens_reasoning_total{user_id=~\"$user\"}[5m]))",
          "legendFormat": "reasoning"
        },
        {
          "refId": "D",
          "expr": "sum(rate(pi_tokens_cache_read_total{user_id=~\"$user\"}[5m]))",
          "legendFormat": "cache read"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Telemetry health",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_telemetry_export_errors_total[5m])) by (otel_signal) or vector(0)",
          "legendFormat": "export errors {{otel_signal}}"
        },
        {
          "refId": "B",
          "expr": "sum(increase(pi_telemetry_dropped_total[5m])) by (otel_signal, reason) or vector(0)",
          "legendFormat": "dropped {{otel_signal}} {{reason}}"
        },
        {
          "refId": "C",
          "expr": "sum(increase(pi_llm_truncated_total{user_id=~\"$user\"}[5m])) or vector(0)",
          "legendFormat": "truncated responses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["pi", "opentelemetry", "organization"],
  "templating": {
    "list": [
      {
        "name": "user",
        "label": "User",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(pi_interaction_count_total, user_id)",
        "definition": "label_values(pi_interaction_count_total, user_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      },
      {
        "name": "repo",
        "label": "Repository",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(pi_interaction_count_total{user_id=~\"$user\"}, pi_repo_slug)",
        "definition": "label_values(pi_interaction_count_total{user_id=~\"$user\"}, pi_repo_slug)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Pi Organization Telemetry",
  "uid": "pi-org-telemetry"
}
